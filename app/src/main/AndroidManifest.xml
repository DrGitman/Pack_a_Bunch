<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Requested at the point of use — when measuring or taking an item photo — never at
      launch. Declining it must leave every typed path working exactly as before.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Used only for catalogue lookups, which are entirely optional: every measurement route
      that matters — typing, AR measuring, depth scanning — works with no connection at all.
      No pack, photo or measurement is ever uploaded.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      AR Optional, and both halves of that matter.

      `required="false"` keeps the app installable on phones with no ARCore support at all,
      which is a large share of Android. The `optional` meta-data stops the Play Store
      installing ARCore automatically as a dependency.

      Together they mean AR can be missing at runtime, so every entry point into it has to
      check availability first and fall back to typing. There is no screen in this app that
      only works with a camera.
    -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".PackABunchApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PackABunch">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PackABunch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data android:name="com.google.ar.core" android:value="optional" />
    </application>

</manifest>
