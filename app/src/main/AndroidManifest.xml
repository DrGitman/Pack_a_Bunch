<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Requested at the point of use — when measuring or taking an item photo — never at
      launch. Declining it must leave every typed path working exactly as before.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Used only for catalogue lookups, which are entirely optional: every measurement route
      that matters — typing, camera measuring, scanning — works with no connection at all.
      No pack, photo or measurement is ever uploaded.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Notices on the phone itself (Android 13+ asks); each kind still obeys its switch in Settings. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Camera measuring needs only the camera, and the camera is optional: the app installs on a
      device without one, and every camera screen offers typing instead. There is no screen in
      this app that only works with a camera.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".PackABunchApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PackABunch">

        <!--
          configChanges: Compose handles all of these itself. Without the list Android
          recreates the activity when the soft keyboard opens, which threw away every piece
          of remembered state — tapping a size field closed the item editor before a number
          could be typed into it.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|touchscreen|density|fontScale|uiMode|layoutDirection|locale"
            android:theme="@style/Theme.PackABunch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The password-reset email's link, back into the app (auth/RecoveryLink.kt). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="packabunch" android:host="reset-password" />
            </intent-filter>
        </activity>

    </application>

</manifest>
